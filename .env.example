# Moon runtime root (recommended explicit setting).
MOON_HOME=$HOME/.moon

# OpenClaw binary path (optional; moon resolves `openclaw` from PATH when unset).
# OPENCLAW_BIN=/absolute/path/to/openclaw
# QMD binary path for recall/embed maintenance.
# QMD_BIN=/absolute/path/to/qmd

# Minimal cleanse profile (required for remote compaction in context-engine flow).
MOON_CLEANSE_PROVIDER=gemini
MOON_CLEANSE_MODEL=gemini-3.1-flash-lite-preview
GEMINI_API_KEY=...

# Optional synthesis profile (`moon distill -mode syns`).
# MOON_WISDOM_PROVIDER=
# MOON_WISDOM_MODEL=
# OPENAI_API_KEY=...
# GEMINI_API_KEY=...
# CLAUDE_API_KEY=...

# Optional OpenAI-compatible profile.
# AI_BASE_URL=https://api.deepseek.com
# AI_API_KEY=...
