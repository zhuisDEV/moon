{
  "id": "moon",
  "kind": "context-engine",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "moonPath": {
        "type": "string"
      },
      "moonHome": {
        "type": "string"
      },
      "memoryDir": {
        "type": "string"
      },
      "memoryFile": {
        "type": "string"
      },
      "contextEngineTimeoutMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 300000
      },
      "contextPacketMaxTokens": {
        "type": "integer",
        "minimum": 200,
        "maximum": 20000
      },
      "contextPacketCandidateThreshold": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "assemblySubagentMode": {
        "type": "string",
        "enum": [
          "disabled",
          "gated"
        ]
      },
      "assemblySubagentProvider": {
        "type": "string"
      },
      "assemblySubagentModel": {
        "type": "string"
      },
      "assemblySubagentTimeoutMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 120000
      },
      "assemblySubagentCacheTtlMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 86400000
      },
      "maxAssemblyChars": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 200000
      },
      "syncAfterTurn": {
        "type": "boolean"
      },
      "fallbackMode": {
        "type": "string",
        "enum": [
          "openclaw",
          "disabled"
        ]
      },
      "compactFallbackOnSkip": {
        "type": "boolean"
      },
      "maxTokens": {
        "type": "integer",
        "minimum": 500,
        "maximum": 500000
      },
      "maxChars": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 200000
      },
      "maxRetainedBytes": {
        "type": "integer",
        "minimum": 0,
        "maximum": 5000000
      },
      "tools": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxTokens": {
              "type": "integer",
              "minimum": 100,
              "maximum": 500000
            },
            "maxChars": {
              "type": "integer",
              "minimum": 200,
              "maximum": 200000
            }
          }
        }
      }
    }
  }
}
