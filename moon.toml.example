[context]
window_mode = "fixed"
# Required when window_mode = "fixed"
window_tokens = 200000
compaction_authority = "moon"
cleanse_trigger_ratio = 0.5
cleanse_emergency_ratio = 0.90

[context_packet]
enabled = true
max_chars = 6000
max_candidates = 18
qmd_limit = 6
recent_memory_files = 4
recent_distill_docs = 4

[watcher]
poll_interval_secs = 60
cooldown_secs = 60

[distill]
max_per_cycle = 3
residential_timezone = "UTC"
syns_trigger_time_local = "00:00"
topic_discovery = true
# L1 archive chunk controls (optional; env fallback still supported).
chunk_bytes = "auto"
max_chunks = 128
model_context_tokens = 200000

[embed]
mode = "auto"
cooldown_secs = 60
max_docs_per_cycle = 3
min_pending_docs = 1
max_cycle_secs = 300

[hot_collection]
# disabled: skip hot qmd lifecycle registration entirely
# degrade: best-effort hot collection registration/removal (default)
# strict: fail checkpoint when hot collection registration/removal fails
lifecycle_mode = "degrade"
# primary: use qmd folder-backed collection add/remove/show commands (default)
# fallback: use alternate lifecycle command forms only
lifecycle_command_mode = "primary"
